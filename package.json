{
  "name": "@axonkit/client-sdk-js",
  "version": "0.2.1",
  "description": "AxonKit JS/TS Client SDK based on mediasoup-client",
  "main": "dist/axonkit-client.umd.js",
  "module": "dist/axonkit-client.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:clean": "rm -rf dist && rollup -c",
    "docs": "typedoc",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run src",
    "dev": "vite examples/demo",
    "size": "size-limit",
    "clean": "rm -rf dist docs",
    "verify:dist": "test -f dist/axonkit-client.esm.js && test -f dist/axonkit-client.umd.js && test -f dist/index.d.ts && ! ls dist/**/*.map 2>/dev/null | grep -q . && echo 'dist OK (no source maps shipped)'",
    "prepublishOnly": "npm run clean && npm run build && npm run verify:dist"
  },
  "keywords": [
    "webrtc",
    "mediasoup",
    "axonkit",
    "realtime"
  ],
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "axonkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axonkit/client-sdk-js.git"
  },
  "homepage": "https://github.com/axonkit/client-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/axonkit/client-sdk-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "dependencies": {
    "async-mutex": "^0.5.0",
    "events": "^3.3.0",
    "mediasoup-client": "^3.18.7",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@size-limit/preset-small-lib": "^12.0.1",
    "@types/events": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "happy-dom": "^17.4.4",
    "prettier": "^3.8.1",
    "rollup": "^4.59.0",
    "size-limit": "^12.0.1",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  },
  "packageManager": "pnpm@10.22.0"
}
